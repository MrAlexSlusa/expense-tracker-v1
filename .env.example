# Copy this file to .env and fill in real values. .env is gitignored, so
# it stays local - never commit real keys.

# From https://resend.com/api-keys, after verifying a sending domain (or use
# the resend.dev sandbox address below for local testing).
RESEND_API_KEY=

# Must be a verified domain/address in your Resend account.
RESEND_FROM_EMAIL=Expense Tracker <onboarding@resend.dev>

# --- Social sign-in (all optional) ---------------------------------------
# A provider's buttons only appear once its credentials are set here; with
# none of this filled in the app behaves exactly as it did before.
#
# Every provider needs this exact callback URL registered on its side:
#   <backend base URL>/api/auth/oauth/<provider>/callback
# e.g. https://expense-tracker-7mnp.onrender.com/api/auth/oauth/google/callback

# Where a finished sign-in is allowed to hand the token back to - a
# comma-separated list of origins. localhost is always allowed. This must
# include the GitHub Pages origin, or social login will refuse to start.
OAUTH_ALLOWED_ORIGINS=https://mralexslusa.github.io

# Only needed if the backend sits behind a proxy that rewrites its own URL;
# otherwise the callback URL is derived from the incoming request.
OAUTH_CALLBACK_BASE_URL=

# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# developer.apple.com -> Certificates, IDs & Profiles. Needs a paid Apple
# Developer account. APPLE_CLIENT_ID is the Services ID (not the App ID), and
# APPLE_PRIVATE_KEY is the contents of the .p8 key with newlines as literal \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Bank sync: Revolut and other PSD2 banks ------------------------------
# Revolut publishes an API for Revolut *Business* only, so a personal
# account is reached as an open-banking (PSD2) account information service.
# GoCardless Bank Account Data is the licensed provider in front of it, has
# a free tier, and covers Revolut in Romania - the app never sees bank
# credentials.
#
# Get these from https://bankaccountdata.gocardless.com/ -> User secrets ->
# Create new. With them unset the bank panel stays hidden and nothing else
# changes.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Only for local testing against the provider's sandbox; leave blank in
# production so the default live URL is used.
GOCARDLESS_BASE_URL=

# Shared secret the scheduled sync presents to POST /api/bank/sync-all (see
# .github/workflows/sync-banks.yml, which reads it from a repository secret
# of the same name). Leave blank and that endpoint 404s, so there is no open
# endpoint on a deploy that never set one up.
CRON_SECRET=

# The bank redirects the browser back to OAUTH_ALLOWED_ORIGINS above once
# consent is given, so that list has to include wherever the frontend is
# served from - the same requirement social sign-in already has.
